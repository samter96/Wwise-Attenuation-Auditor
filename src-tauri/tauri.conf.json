{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Attenuation Auditor",
  "version": "2.0.0",
  "identifier": "com.attenuationauditor.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Attenuation Auditor",
        "width": 1180,
        "height": 760,
        "minWidth": 860,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": false,
        "backgroundColor": "#090b0f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "resources/auditor_backend.exe": "auditor_backend.exe"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Audit Wwise positioning and attenuation integrity.",
    "longDescription": "Scans the Wwise Actor-Mixer Hierarchy for effective Positioning and Attenuation mismatches."
  }
}
